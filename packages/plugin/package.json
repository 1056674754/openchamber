  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"./src/**/*.ts\" --config ../../eslint.config.js"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.14.0",
    "@opencode-ai/sdk": "1.18.31",
    "zod": "^4.1.8"
  }
}
