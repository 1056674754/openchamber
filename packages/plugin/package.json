{
  "name": "@openchamber/plugin",
  "version": "1.10.4",
  "private": true,
  "type": "module",
  "description": "OpenChamber first-party OpenCode plugin — image fallback for non-vision models, cross-session image cache, and UI-enhancing hooks.",
  "main": "src/index.ts",
  "exports": {
    ".": {
